{
  "name": "dsh-plugin-general-improvements",
  "version": "0.1.0",
  "description": "General improvements to the DSH Web GUI: a persistent error indicator on sidebar session rows (failed / interrupted / blocked turns are never silent), plus a right-click menu to clear it or to mark a session unread manually.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erkkimon/dsh-plugin-general-improvements.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "sessions",
    "error",
    "unread",
    "context-menu"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session-query": "^0.1.2-rc.1"
  }
}
